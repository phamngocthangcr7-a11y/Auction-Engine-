{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/auction-engine-web/welcome.html"
    },
    {
      "source": "/welcome",
      "destination": "/auction-engine-web/welcome.html"
    },
    {
      "source": "/((?!auction-engine-web/).*)",
      "destination": "/auction-engine-web/$1"
    }
  ]
}
